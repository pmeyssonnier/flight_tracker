# Identifiants OpenSky Network (OAuth2) — https://opensky-network.org → API Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bearer token OAuth2 (optionnel) : si renseigné, il est utilisé directement
# sans appel au serveur d'authentification. Obtenu par exemple avec :
#   curl -X POST https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token \
#     -H "Content-Type: application/x-www-form-urlencoded" \
#     -d "grant_type=client_credentials&client_id=$OPENSKY_CLIENT_ID&client_secret=$OPENSKY_CLIENT_SECRET"
OPENSKY_TOKEN=

# Proxy CORS personnalisé (optionnel, ex: https://mon-proxy.worker.dev/?url=)
OPENSKY_PROXY_URL=

# Appareil suivi par défaut (optionnel)
AIRCRAFT_REG=
AIRCRAFT_ICAO24=
